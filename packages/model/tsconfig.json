{
    "compilerOptions": {
        "outDir": "./build",
        "rootDir": "./src",
        "baseUrl": "./src",
        "target": "es6",
        "module": "CommonJS",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build"]
}